# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# MakoBot injected files (personal preferences)
CLAUDE.md
AGENTS.md
.cursorrules
# ...and the .bak copies MakoBot writes beside them. Without this line the
# backups carry the same personal content straight into a PUBLIC repo, which
# is how CLAUDE.md.bak / AGENTS.md.bak / .cursorrules.bak got committed.
*.bak

# Playwright MCP scratch snapshots — tool output, never source
.playwright-mcp/

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*.local
# MakoBot MCP config contains a local auth token — do not commit
.mcp.json
.mcp.json.*
.cursor/mcp.json
.cursor/mcp.json.*
